<!DOCTYPE html>
<html lang="de">
<head>
    <meta charset="UTF-8">
    <title>Gym Logbuch</title>
    <style>
        body {
            font-family: Arial, sans-serif;
            margin: 30px;
        }
        h2 {
            margin-top: 50px;
        }
        table {
            width: 100%;
            border-collapse: collapse;
            margin-top: 15px;
        }
        th, td {
            border: 1px solid black;
            padding: 6px;
            text-align: center;
            vertical-align: top;
        }
        th {
            background-color: #f2f2f2;
        }
        input {
            width: 90%;
            border: none;
            text-align: center;
            font-family: inherit;
            font-size: 1em;
        }
        input[type=number]::-webkit-inner-spin-button,
        input[type=number]::-webkit-outer-spin-button {
            -webkit-appearance: none;
            margin: 0;
        }
        input[type=number] {
            -moz-appearance: textfield;
        }
        .hint {
            display: block;
            font-size: 0.7em;
            color: #777;
            margin-top: 2px;
            min-height: 1em;
        }
        .header-info {
            margin-bottom: 20px;
        }
        button {
            margin-right: 6px;
            margin-bottom: 6px;
        }
        #restMessage {
            margin-top: 20px;
            padding: 15px;
            background: #f2f2f2;
            border: 1px solid black;
        }
    </style>
</head>
<body>

<h1>Workout Logbuch</h1>

<h2>Training manuell wählen</h2>
<button onclick="setDay(0)">Torso A</button>
<button onclick="setDay(1)">Limbs A</button>
<button onclick="setDay(2)">Torso B</button>
<button onclick="setDay(3)">Limbs B</button>
<button onclick="setDay(4)">Rest</button>

<div id="trainingSections"></div>

<div id="restMessage" style="display:none;">Heute ist Restday – kein Training geplant. Gute Erholung! 💪</div>

<button id="saveBtn" onclick="saveWorkout()">Training speichern</button>

<h2>Gespeicherte Trainings-Tage</h2>
<div id="history"></div>


<script>
/* Die 4 Trainingstypen im Rotations-Zyklus (Index = cycleDay), 4 = Restday */
const TRAINING_TYPES = ["torsoA", "limbsA", "torsoB", "limbsB"];
const DAY_LABELS = {
    torsoA: "Torso A",
    limbsA: "Limbs A",
    torsoB: "Torso B",
    limbsB: "Limbs B"
};
const REST_DAY = 4;

/* ---------- Storage-Helfer ----------
   Nutzt die persistente Artifact-Storage, wenn verfügbar (Claude-Vorschau).
   Läuft die Seite als eigenständige HTML-Datei in einem normalen Browser
   (dort existiert window.storage nicht), wird automatisch auf localStorage
   umgeschaltet, damit Speichern/Laden trotzdem funktioniert. */
const hasArtifactStorage = typeof window.storage !== "undefined";

async function storageGet(key, fallback = null) {
    if (hasArtifactStorage) {
        try {
            const result = await window.storage.get(key, false);
            return result ? result.value : fallback;
        } catch (e) {
            return fallback;
        }
    }
    const value = localStorage.getItem(key);
    return value !== null ? value : fallback;
}

async function storageSet(key, value) {
    if (hasArtifactStorage) {
        try {
            await window.storage.set(key, value, false);
        } catch (e) {
            console.error("Storage-Fehler:", e);
        }
        return;
    }
    localStorage.setItem(key, value);
}

function todayFormatted() {
    let today = new Date();
    return today.getDate().toString().padStart(2, '0') + '.' +
           (today.getMonth() + 1).toString().padStart(2, '0') + '.' +
           today.getFullYear();
}

/* ---------- Tabellen dynamisch aufbauen (DRY + macht Hints möglich) ---------- */
function buildExerciseRow() {
    let tr = document.createElement("tr");

    let nameTd = document.createElement("td");
    let nameInput = document.createElement("input");
    nameInput.type = "text";
    nameInput.placeholder = "Übung";
    nameTd.appendChild(nameInput);
    tr.appendChild(nameTd);

    const cols = [
        { kind: "weight" }, { kind: "reps" },   // Aufwärmsatz
        { kind: "weight" }, { kind: "reps" },   // Arbeitssatz 1
        { kind: "weight" }, { kind: "reps" }    // Arbeitssatz 2
    ];

    cols.forEach(col => {
        let td = document.createElement("td");
        let input = document.createElement("input");
        input.type = "number";
        input.step = col.kind === "weight" ? "0.5" : "1";
        input.inputMode = col.kind === "weight" ? "decimal" : "numeric";
        input.placeholder = col.kind === "weight" ? "kg" : "Wdh";
        let hint = document.createElement("small");
        hint.className = "hint";
        td.appendChild(input);
        td.appendChild(hint);
        tr.appendChild(td);
    });

    return tr;
}

function buildTable(type) {
    let table = document.createElement("table");
    table.id = type + "Table";
    table.style.display = "none";

    let thead = document.createElement("thead");
    thead.innerHTML = `
        <tr>
            <th rowspan="2">Übung</th>
            <th colspan="2">Aufwärmsatz</th>
            <th colspan="2">Arbeitssatz 1</th>
            <th colspan="2">Arbeitssatz 2</th>
        </tr>
        <tr>
            <th>Gewicht</th><th>Wdh</th>
            <th>Gewicht</th><th>Wdh</th>
            <th>Gewicht</th><th>Wdh</th>
        </tr>`;
    table.appendChild(thead);

    let tbody = document.createElement("tbody");
    for (let i = 0; i < 8; i++) {
        tbody.appendChild(buildExerciseRow());
    }
    table.appendChild(tbody);

    return table;
}

function buildSections() {
    let container = document.getElementById("trainingSections");
    TRAINING_TYPES.forEach(type => {
        let header = document.createElement("h2");
        header.id = type + "Header";
        header.textContent = DAY_LABELS[type];
        header.style.display = "none";

        container.appendChild(header);
        container.appendChild(buildTable(type));
    });
}

/* ---------- Speichern / Laden ---------- */
async function saveWorkout() {
    let cycleDay = await getCycleDay();
    if (cycleDay === REST_DAY) return; // Button ist an Restdays ohnehin ausgeblendet

    let type = TRAINING_TYPES[cycleDay];
    let formattedDate = todayFormatted();
    let workout = { date: formattedDate, type: type, data: [] };

    let rows = document.querySelectorAll(`#${type}Table tbody tr`);
    rows.forEach(row => {
        let inputs = row.querySelectorAll("input");
        workout.data.push([...inputs].map(input => input.value));
    });

    let history = JSON.parse(await storageGet("workouts", "[]"));

    // prüfen ob heute (für diesen Trainingstyp) schon existiert
    let existingIndex = history.findIndex(w => w.date === formattedDate && w.type === type);
    if (existingIndex !== -1) {
        history[existingIndex] = workout;
    } else {
        history.push(workout);
    }

    await storageSet("workouts", JSON.stringify(history));

    await displayHistory();
    await nextDay();
    await showTodayWorkout();
}

/* Lädt das letzte Workout des Typs in die Tabelle, ohne das Display zu ändern */
async function loadLastWorkout(type) {
    let history = JSON.parse(await storageGet("workouts", "[]"));
    if (history.length === 0) return;

    let lastWorkout = [...history].reverse().find(w => w.type === type);
    if (!lastWorkout) return;

    let rows = document.querySelectorAll(`#${type}Table tbody tr`);
    rows.forEach((row, index) => {
        if (lastWorkout.data[index]) {
            let inputs = row.querySelectorAll("input");
            lastWorkout.data[index].forEach((val, i) => inputs[i].value = val);
        }
    });
}

async function loadTodayWorkout(type) {
    let history = JSON.parse(await storageGet("workouts", "[]"));
    let formattedDate = todayFormatted();

    let todayWorkout = history.find(w => w.date === formattedDate && w.type === type);
    if (!todayWorkout) return false;

    let rows = document.querySelectorAll(`#${type}Table tbody tr`);
    rows.forEach((row, index) => {
        if (todayWorkout.data[index]) {
            let inputs = row.querySelectorAll("input");
            todayWorkout.data[index].forEach((val, i) => inputs[i].value = val);
        }
    });

    return true;
}

/* Zeigt "zuletzt: X" unter jedem Gewicht/Wdh-Feld, bezogen auf die letzte
   Session, die NICHT von heute ist – bleibt also auch nach dem Editieren
   des Eingabefelds als Vergleichswert sichtbar. */
async function updateHints(type) {
    let history = JSON.parse(await storageGet("workouts", "[]"));
    let formattedDate = todayFormatted();

    let previous = [...history].reverse().find(w => w.type === type && w.date !== formattedDate);

    let rows = document.querySelectorAll(`#${type}Table tbody tr`);
    rows.forEach((row, rowIndex) => {
        let hints = row.querySelectorAll(".hint");
        let data = previous ? previous.data[rowIndex] : null;
        hints.forEach((hint, i) => {
            let value = data ? data[i + 1] : "";
            hint.textContent = value ? `zuletzt: ${value}` : "";
        });
    });
}

/* ---------- Historie ---------- */
async function displayHistory() {
    let history = JSON.parse(await storageGet("workouts", "[]"));
    let container = document.getElementById("history");
    container.innerHTML = "";

    history.slice().reverse().forEach(workout => {
        let wrapper = document.createElement("div");
        wrapper.style.border = "1px solid black";
        wrapper.style.marginBottom = "15px";
        wrapper.style.padding = "10px";

        let header = document.createElement("div");
        header.style.cursor = "pointer";
        header.style.fontWeight = "bold";
        header.innerText = workout.date + " – " + (DAY_LABELS[workout.type] || workout.type) + " ▼";

        let content = document.createElement("div");
        content.style.display = "none";
        content.style.marginTop = "10px";

        workout.data.forEach(row => {
            if (row[0] !== "") {
                content.innerHTML += `<div style="margin-bottom:8px;">
                    <strong>${row[0]}</strong><br>
                    Aufwärm: ${row[1]}kg × ${row[2]}<br>
                    Satz 1: ${row[3]}kg × ${row[4]}<br>
                    Satz 2: ${row[5]}kg × ${row[6]}
                </div>`;
            }
        });

        header.onclick = () => { content.style.display = content.style.display === "none" ? "block" : "none"; };
        wrapper.appendChild(header);
        wrapper.appendChild(content);
        container.appendChild(wrapper);
    });
}

/* ---------- Zyklus-Steuerung ---------- */
async function getCycleDay() {
    let stored = await storageGet("cycleDay", null);
    if (stored === null) {
        await storageSet("cycleDay", JSON.stringify(0)); // Start = Torso A
        return 0;
    }
    return JSON.parse(stored);
}

async function showTodayWorkout() {
    let cycleDay = await getCycleDay();

    TRAINING_TYPES.forEach(type => {
        document.getElementById(type + "Table").style.display = "none";
        document.getElementById(type + "Header").style.display = "none";
    });

    let restMessage = document.getElementById("restMessage");
    let saveBtn = document.getElementById("saveBtn");

    if (cycleDay === REST_DAY) {
        restMessage.style.display = "block";
        saveBtn.style.display = "none";
        return;
    }

    restMessage.style.display = "none";
    saveBtn.style.display = "inline-block";

    let type = TRAINING_TYPES[cycleDay];
    document.getElementById(type + "Header").style.display = "block";
    document.getElementById(type + "Table").style.display = "table";

    // erst heutiges Training laden, sonst letztes
    if (!(await loadTodayWorkout(type))) {
        await loadLastWorkout(type);
    }
    await updateHints(type);
}

async function nextDay() {
    let cycleDay = await getCycleDay();
    cycleDay = (cycleDay + 1) % (TRAINING_TYPES.length + 1); // +1 für Restday
    await storageSet("cycleDay", JSON.stringify(cycleDay));
}

async function setDay(day) {
    await storageSet("cycleDay", JSON.stringify(day));
    await showTodayWorkout();
}

/* ---------- Start ---------- */
async function init() {
    buildSections();
    await displayHistory();
    await showTodayWorkout();
}

init();
</script>

</body>
</html>
